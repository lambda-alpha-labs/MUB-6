/-
  MasterProof.lean

  The finite graph certificates and the two obstruction theorems.

  Trust boundary
  --------------
  * The S6 *algebra* is checked in `Algebra.lean`: 90 unit vectors and
    540 exact inner products, all kernel `decide`.
  * `s6OrthoMask` is the packed cross-check for the exact S6
    orthogonality computation.  It is identically zero; the primary
    statement is `s6_no_ortho_exact` in `Algebra.lean`, which checks all
    8100 inner products directly.
  * `f6Bases`, `f6OrthoMask` and `f6MubMask` are generated by
    `python/generate_facts.py`.  The F6 coordinates are the 48 Bjorck
    biunimodular vectors; the graph is certified numerically with the
    margin recorded in `data/summary.json` (non-edge margin 0.430...,
    edge error below 1e-14).  The lean layer checks the resulting
    finite certificate.
  * The *completeness* of the 48 F6 vectors and the 90 S6 vectors is the
    published Brierley-Weigert input, assumed as a premise.  See the
    README.  Lean is not asked to re-prove the classification of all
    unbiased vectors.

  No `native_decide`, no `sorry`, and no Mathlib is required in this
  file or in `Algebra.lean`.
-/

import MUB6.Algebra
import MUB6.Certificates

namespace MUB6

/-- Read bit `i` of a packed `UInt64` array. -/
def bit (a : Array UInt64) (i : Nat) : Bool :=
  (Array.getD a (i / 64) 0).toNat.testBit (i % 64)

/-! ## S6: no orthogonal pair, hence no third basis -/

/-- The S6 orthogonality mask is the all-zero array. -/
theorem getD_s6 (i : Nat) : Array.getD s6OrthoMask i 0 = 0 := by
  unfold Array.getD
  by_cases h : i < s6OrthoMask.size
  · simp [s6OrthoMask, Array.getElem_replicate]
  · simp [h]

theorem bit_s6_zero (i : Nat) : bit s6OrthoMask i = false := by
  unfold bit
  rw [getD_s6, UInt64.toNat_zero, Nat.zero_testBit]

/-- Strong exact obstruction, derived from `s6_no_ortho_exact`:
no two of the 90 exact vectors are orthogonal.  A third basis would
contain six mutually orthogonal vectors, in particular an orthogonal
pair, so this rules out a third basis. -/
theorem s6_no_orthogonal_pair_exact (i j : Nat)
    (hi : i < 90) (hj : j < 90) (hij : i ≠ j) :
    isOrthoPair (List.getD s6Vectors i []) (List.getD s6Vectors j []) = false := by
  have h := s6_no_ortho_exact
  rw [List.all_eq_true] at h
  have h1 := h i (List.mem_range.mpr hi)
  rw [List.all_eq_true] at h1
  have h2 := h1 j (List.mem_range.mpr hj)
  simp [hij] at h2
  exact h2

/-- Mask cross-check: the generated S6 orthogonality mask is identically
zero, in packed form.  The exact theorem above is the primary statement. -/
theorem s6_no_orthogonal_pair :
    ∀ i j : Fin 90, i ≠ j → bit s6OrthoMask (i.val * 90 + j.val) = false := by
  intro i j _
  exact bit_s6_zero _

/-- Packed form of `s6_no_orthogonal_pair`, convenient for auditing. -/
theorem s6_no_orthogonal_pair_all :
    (List.range 90).all (fun i =>
      (List.range 90).all (fun j =>
        i == j || !(bit s6OrthoMask (i * 90 + j)))) = true := by
  simp [bit_s6_zero]

/-! ## F6: all 6-cliques are valid bases, and no two are MUB -/

/-- `b` is a clique in the F6 orthogonality graph (duplicates allowed;
`f6_bases_valid` separately rules them out). -/
def isClique (b : List Nat) : Bool :=
  b.all (fun i => b.all (fun j => i == j || bit f6OrthoMask (i * 48 + j)))

/-- Every cross pair between `b1` and `b2` is unbiased. -/
def isMubPair (b1 b2 : List Nat) : Bool :=
  b1.all (fun i => b2.all (fun j => bit f6MubMask (i * 48 + j)))

/-- The Datalog-injected base list, under the requested name. -/
def bases16 : List (List Nat) := f6Bases

/-- The Datalog-injected MUB-adjacency mask, under the requested name. -/
def mubAdjMask : Array UInt64 := f6MubMask

theorem f6_code_count : f6Codes.length = 48 := by
  decide

theorem f6_base_count : bases16.length = 16 := by
  decide

/-- Every injected base has six distinct vertices and is a clique in the
F6 orthogonality graph. -/
theorem f6_bases_valid :
    bases16.all
      (fun b => b.length == 6 && b.eraseDups.length == 6 && isClique b) = true := by
  decide

/-- No two of the 16 bases are mutually unbiased.  This is the finite
obstruction: every quartet containing the standard/Fourier pair would
need two of these 16 bases to be MUB. -/
theorem f6_no_mub_pair :
    bases16.all
      (fun b1 => bases16.all
        (fun b2 => b1 == b2 || !(isMubPair b1 b2))) = true := by
  decide

/-- Sanity check: no base is MUB with itself (the diagonal is not a
cross-basis claim, but the mask is deliberately not diagonal). -/
theorem f6_self_not_mub :
    bases16.all (fun b => !(isMubPair b b)) = true := by
  decide

end MUB6
